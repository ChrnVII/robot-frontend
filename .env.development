# 真实后端开发配置：留空 VITE_SERVER_URL，请求走同源相对路径 + Vite 代理。
VITE_SERVER_URL=
# 后端默认地址（inspection-robot/backend，端口 8100）
VITE_PROXY_TARGET=http://127.0.0.1:8100
# 底盘循迹服务地址（track.vue 走的 /track-api 代理目标，端口 9100）
# 这里必须是「运行 Vite 的这台机器」能访问到的地址：服务在本机就用 127.0.0.1，
# 服务在机器人/另一台主机上就改成那台机器的 IP（如 http://192.168.136.10:9100）。
VITE_TRACK_PROXY_TARGET=http://127.0.0.1:9100
# Axios 请求超时（毫秒）
VITE_REQUEST_TIMEOUT=10000
# 控制命令签发者标识
VITE_CONTROL_HOLDER=inspection-console